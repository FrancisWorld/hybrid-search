# Directory holding the index (segments, WAL, manifest).
HYBRID_SEARCH_DIR=./data/index
# Set to 0 to skip fsync on WAL writes (faster, not crash-safe).
HYBRID_SEARCH_FSYNC=1
# Used only when the index directory is created for the first time.
HYBRID_SEARCH_LANGUAGE=en
HYBRID_SEARCH_KEYWORDS=category,tags
HYBRID_SEARCH_NUMBERS=year
HYBRID_SEARCH_DIM=256
